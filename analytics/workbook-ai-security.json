          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "promptshield"
      },
      "name": "group-prompt-shield"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## ⚔️ Seguridad — Vista Combinada\n---\n<div style=\"background: linear-gradient(90deg, #D13438 0%, #5C2D91 50%, #0078D4 100%); padding: 10px 20px; border-radius: 8px; margin-bottom: 12px;\">\n<span style=\"color: #fff; font-size: 13px;\">Análisis unificado de ambas capas de protección: <strong>Content Safety</strong> + <strong>Prompt Shield</strong></span>\n</div>"
            },
            "name": "section-4-title"
          },
          {
            "type": 1,
            "content": {
              "json": "### 4.1 Detalle de todos los bloqueos con categoría y severidad"
            },
            "name": "label-4-1"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ApiManagementGatewayLogs\n| where TimeGenerated {TimeRange}\n| where ApiId == \"github-redirection\"\n| where ResponseCode == 400\n| where Method == \"POST\"\n| where ResponseBody has \"Content Safety\" or ResponseBody has \"Prompt Shield\"\n| extend\n    Prompt = extract(@\"\"\"content\"\":\\s*\"\"([^\"\"]+)\"\"\", 1, RequestBody),\n    BlockedBy = case(\n        ResponseBody has \"Prompt Shield\", \"Prompt Shield\",\n        ResponseBody has \"Content Safety\", \"Content Safety\",\n        \"Unknown\"\n    ),\n    FlaggedCategories = parse_json(ResponseBody).flagged_categories\n| mv-expand FlaggedCategories\n| extend\n    Category = case(\n        BlockedBy == \"Prompt Shield\", \"Jailbreak/Injection\",\n        isnotempty(tostring(FlaggedCategories.category)), tostring(FlaggedCategories.category),\n        \"Unknown\"\n    ),\n    Severity = case(\n        BlockedBy == \"Prompt Shield\", 10,\n        toint(FlaggedCategories.severity)\n    )\n| project TimeGenerated, CallerIpAddress, Prompt, BlockedBy, Category, Severity, TotalTime\n| order by TimeGenerated desc",
              "size": 0,
              "showAnalytics": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Severity",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        { "operator": ">=", "thresholdValue": "10", "representation": "redDark", "text": "🔴 {0}" },
                        { "operator": ">=", "thresholdValue": "4", "representation": "redBright", "text": "🟠 {0}" },
                        { "operator": ">=", "thresholdValue": "2", "representation": "orange", "text": "🟡 {0}" },
                        { "operator": "Default", "representation": "yellow", "text": "{0}" }
                      ]
                    }
                  },
                  {
                    "columnMatch": "BlockedBy",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        { "operator": "contains", "thresholdValue": "Prompt Shield", "representation": "purple", "text": "🛡️ {0}" },
                        { "operator": "contains", "thresholdValue": "Content Safety", "representation": "redBright", "text": "🔒 {0}" },
                        { "operator": "Default", "representation": "gray", "text": "{0}" }
                      ]
                    }
                  },
                  {
                    "columnMatch": "Category",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        { "operator": "contains", "thresholdValue": "Jailbreak", "representation": "Sev0", "text": "🚨 {0}" },
                        { "operator": "contains", "thresholdValue": "Hate", "representation": "Sev1", "text": "⛔ {0}" },
                        { "operator": "contains", "thresholdValue": "Violence", "representation": "Sev1", "text": "💥 {0}" },
