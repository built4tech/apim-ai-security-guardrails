                    "columnMatch": "AvgLatency",
                    "formatter": 8,
                    "formatOptions": { "palette": "coldHot" },
                    "numberFormat": {
                      "unit": 23,
                      "options": { "style": "decimal", "maximumFractionDigits": 0 }
                    }
                  }
                ]
              }
            },
            "name": "query-11-2-comparison"
