        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 👥 Análisis de Uso\n---\n<div style=\"background: linear-gradient(90deg, #0078D4 0%, #00B7C3 100%); padding: 10px 20px; border-radius: 8px; margin-bottom: 12px;\">\n<span style=\"color: #fff; font-size: 13px;\">Patrones de uso de la plataforma: usuarios, modelos y actividad horaria</span>\n</div>"
