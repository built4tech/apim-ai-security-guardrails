            "type": 1,
            "content": {
              "json": "## 📋 Informe Ejecutivo\n---\n<div style=\"background: linear-gradient(90deg, #323130 0%, #605E5C 100%); padding: 10px 20px; border-radius: 8px; margin-bottom: 12px;\">\n<span style=\"color: #fff; font-size: 13px;\">Resumen ejecutivo para reporting y toma de decisiones</span>\n</div>"
