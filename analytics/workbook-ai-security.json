                      ]
                    }
                  }
                ],
                "sortBy": [
                  { "itemKey": "IntentosJailbreak", "sortOrder": 2 }
                ]
              }
            },
            "customWidth": "50",
            "name": "query-3-2-top-ips"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ApiManagementGatewayLogs\n| where TimeGenerated {TimeRange}\n| where ApiId == \"github-redirection\"\n| where Method == \"POST\"\n| where ResponseCode == 400\n| where ResponseBody has \"Prompt Shield\"\n| summarize Intentos = count() by bin(TimeGenerated, {TimeRange:grain})\n| order by TimeGenerated asc",
              "size": 0,
              "title": "3.3 Tendencia de intentos de jailbreak",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "areachart",
              "chartSettings": {
                "seriesLabelSettings": [
                  { "seriesName": "Intentos", "color": "purple" }
                ],
