        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 🪙 Análisis de Tokens y Costes\n---\n<div style=\"background: linear-gradient(90deg, #107C10 0%, #00B7C3 100%); padding: 10px 20px; border-radius: 8px; margin-bottom: 12px;\">\n<span style=\"color: #fff; font-size: 13px;\">Consumo de tokens por modelo y usuario — Visibilidad de costes operativos</span>\n</div>"
            },
            "name": "section-7-title"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ApiManagementGatewayLogs\n| where TimeGenerated {TimeRange}\n| where ApiId == \"github-redirection\"\n| where Method == \"POST\"\n| where ResponseCode == 200\n| where isnotempty(BackendResponseBody)\n| extend\n    TotalTokens = toint(extract(@\"\"\"total_tokens\"\":(\\d+)\", 1, BackendResponseBody)),\n    Model = extract(@\"\"\"model\"\":\\s*\"\"([^\"\"]+)\"\"\", 1, BackendResponseBody)\n| where isnotnull(TotalTokens)\n| summarize\n    Peticiones = count(),\n    TokensConsumidos = sum(TotalTokens),\n    AvgTokensPorPeticion = round(avg(TotalTokens), 0)\n    by bin(TimeGenerated, {TimeRange:grain}), Model\n| order by TimeGenerated asc",
              "size": 0,
              "title": "7.2 Consumo total de tokens por día y modelo",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "areachart",
              "chartSettings": {
                "ySettings": { "min": 0 }
              }
