          {
            "type": 1,
            "content": {
              "json": "### 11.1 Resumen semanal"
            },
            "name": "label-11-1"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ApiManagementGatewayLogs\n| where TimeGenerated > ago(7d)\n| where ApiId == \"github-redirection\"\n| where Method == \"POST\"\n| summarize\n    TotalPeticiones = count(),\n    PeticionesExitosas = countif(ResponseCode == 200),\n    BloqueosContentSafety = countif(ResponseCode == 400 and ResponseBody has \"Content Safety\"),\n    BloqueosPromptShield = countif(ResponseCode == 400 and ResponseBody has \"Prompt Shield\"),\n    ErroresBackend = countif(ResponseCode >= 500),\n    UsuariosUnicos = dcount(CallerIpAddress),\n    LatenciaMediaMs = round(avg(TotalTime), 0),\n    LatenciaP95Ms = round(percentile(TotalTime, 95), 0)\n| extend\n    TasaExito = round(100.0 * PeticionesExitosas / TotalPeticiones, 1),\n    TasaBloqueo = round(100.0 * (BloqueosContentSafety + BloqueosPromptShield) / TotalPeticiones, 1),\n    TotalBloqueos = BloqueosContentSafety + BloqueosPromptShield",
              "size": 4,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Column1",
                  "formatter": 1
                },
                "showBorder": false,
                "size": "auto"
              }
            },
            "name": "query-11-1-summary"
          },
          {
            "type": 1,
            "content": {
              "json": "### 11.2 Comparativa semana actual vs semana anterior"
            },
            "name": "label-11-2"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let SemanaActual = ApiManagementGatewayLogs\n| where TimeGenerated > ago(7d)\n| where ApiId == \"github-redirection\"\n| where Method == \"POST\"\n| summarize\n    Peticiones = count(),\n    Exitosas = countif(ResponseCode == 200),\n    Bloqueadas = countif(ResponseCode == 400),\n    AvgLatency = round(avg(TotalTime), 0)\n| extend Periodo = \"Semana actual\";\nlet SemanaAnterior = ApiManagementGatewayLogs\n| where TimeGenerated between (ago(14d) .. ago(7d))\n| where ApiId == \"github-redirection\"\n| where Method == \"POST\"\n| summarize\n    Peticiones = count(),\n    Exitosas = countif(ResponseCode == 200),\n    Bloqueadas = countif(ResponseCode == 400),\n    AvgLatency = round(avg(TotalTime), 0)\n| extend Periodo = \"Semana anterior\";\nunion SemanaActual, SemanaAnterior\n| project Periodo, Peticiones, Exitosas, Bloqueadas, AvgLatency",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
