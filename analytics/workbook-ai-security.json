      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 📊 Visión General de Actividad\n---"
            },
            "name": "section-1-title"
          },
          {
            "type": 1,
            "content": {
              "json": "### 1.1 Resumen de actividad",
              "style": "upsell"
            },
            "name": "label-1-1"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ApiManagementGatewayLogs\n| where TimeGenerated {TimeRange}\n| where ApiId == \"github-redirection\"\n| where Method == \"POST\"\n| summarize\n    TotalRequests = count(),\n    SuccessfulRequests = countif(ResponseCode == 200),\n    BlockedByContentSafety = countif(ResponseCode == 400 and ResponseBody has \"Content Safety\"),\n    BlockedByPromptShield = countif(ResponseCode == 400 and ResponseBody has \"Prompt Shield\"),\n    BackendErrors = countif(ResponseCode == 502),\n    OtherErrors = countif(ResponseCode != 200 and ResponseCode != 400 and ResponseCode != 502),\n    AvgLatencyMs = round(avg(TotalTime), 0),\n    P95LatencyMs = round(percentile(TotalTime, 95), 0),\n    UniqueUsers = dcount(CallerIpAddress)",
              "size": 4,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Column1",
                  "formatter": 1
                },
                "showBorder": false,
                "rowLimit": 10,
                "size": "auto"
              }
            },
            "name": "query-1-1-dashboard"
          },
          {
            "type": 1,
            "content": {
              "json": "### 1.2 Evolución temporal de peticiones"
            },
            "name": "label-1-2"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ApiManagementGatewayLogs\n| where TimeGenerated {TimeRange}\n| where ApiId == \"github-redirection\"\n| where Method == \"POST\"\n| summarize\n    Total = count(),\n    Exitosas = countif(ResponseCode == 200),\n    Bloqueadas = countif(ResponseCode == 400),\n    Errores = countif(ResponseCode >= 500)\n    by bin(TimeGenerated, {TimeRange:grain})\n| order by TimeGenerated asc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "areachart",
              "chartSettings": {
                "seriesLabelSettings": [
                  { "seriesName": "Exitosas", "color": "green" },
                  { "seriesName": "Bloqueadas", "color": "redBright" },
                  { "seriesName": "Errores", "color": "orange" },
                  { "seriesName": "Total", "color": "blue" }
                ],
                "ySettings": {
                  "min": 0
                }
              }
            },
            "name": "query-1-2-evolution"
          },
          {
            "type": 1,
            "content": {
              "json": "### 1.3 Tasa de éxito vs bloqueo"
            },
            "name": "label-1-3"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ApiManagementGatewayLogs\n| where TimeGenerated {TimeRange}\n| where ApiId == \"github-redirection\"\n| where Method == \"POST\"\n| summarize\n    Total = count(),\n    Exitosas = countif(ResponseCode == 200),\n    Bloqueadas = countif(ResponseCode == 400)\n    by bin(TimeGenerated, {TimeRange:grain})\n| extend\n    TasaExito = round(100.0 * Exitosas / Total, 1),\n    TasaBloqueo = round(100.0 * Bloqueadas / Total, 1)\n| project TimeGenerated, TasaExito, TasaBloqueo\n| order by TimeGenerated asc",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "linechart",
              "chartSettings": {
                "seriesLabelSettings": [
                  { "seriesName": "TasaExito", "label": "% Éxito", "color": "green" },
                  { "seriesName": "TasaBloqueo", "label": "% Bloqueo", "color": "redBright" }
                ],
                "ySettings": {
                  "min": 0,
                  "max": 100
                },
                "yAxis": "TasaExito"
              }
            },
            "name": "query-1-3-rates"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "overview"
      },
      "name": "group-overview"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 🔒 Seguridad — Content Safety\n---\n<div style=\"background: linear-gradient(90deg, #D13438 0%, #F2545B 100%); padding: 10px 20px; border-radius: 8px; margin-bottom: 12px;\">\n<span style=\"color: #fff; font-size: 13px;\">Detección de contenido tóxico: <strong>Hate</strong> · <strong>SelfHarm</strong> · <strong>Sexual</strong> · <strong>Violence</strong></span>\n</div>"
            },
            "name": "section-2-title"
          },
          {
            "type": 1,
            "content": {
              "json": "### 2.1 Peticiones bloqueadas por Content Safety (detalle)"
            },
            "name": "label-2-1"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ApiManagementGatewayLogs\n| where TimeGenerated {TimeRange}\n| where ApiId == \"github-redirection\"\n| where ResponseCode == 400\n| where Method == \"POST\"\n| where ResponseBody has \"Content Safety\"\n| extend\n    Prompt = extract(@\"\"\"content\"\":\\s*\"\"([^\"\"]+)\"\"\", 1, RequestBody),\n    BlockedBy = \"Content Safety\",\n    FlaggedCategories = parse_json(ResponseBody).flagged_categories\n| mv-expand FlaggedCategories\n| extend\n    Category = tostring(FlaggedCategories.category),\n    Severity = toint(FlaggedCategories.severity)\n| project TimeGenerated, CallerIpAddress, Prompt, BlockedBy, Category, Severity, TotalTime\n| order by TimeGenerated desc",
              "size": 0,
              "showAnalytics": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Severity",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        { "operator": ">=", "thresholdValue": "4", "representation": "redBright", "text": "{0}" },
                        { "operator": ">=", "thresholdValue": "2", "representation": "orange", "text": "{0}" },
                        { "operator": "Default", "representation": "yellow", "text": "{0}" }
                      ]
                    }
                  },
                  {
                    "columnMatch": "BlockedBy",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        { "operator": "Default", "thresholdValue": null, "representation": "Sev2", "text": "{0}" }
                      ]
                    }
                  },
                  {
                    "columnMatch": "TotalTime",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "coldHot"
                    },
                    "numberFormat": {
                      "unit": 23,
                      "options": { "style": "decimal", "maximumFractionDigits": 0 }
                    }
                  },
                  {
                    "columnMatch": "Category",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        { "operator": "contains", "thresholdValue": "Hate", "representation": "4", "text": "⛔ {0}" },
                        { "operator": "contains", "thresholdValue": "Violence", "representation": "4", "text": "💥 {0}" },
                        { "operator": "contains", "thresholdValue": "SelfHarm", "representation": "Sev1", "text": "⚠️ {0}" },
                        { "operator": "contains", "thresholdValue": "Sexual", "representation": "Sev2", "text": "🔞 {0}" },
                        { "operator": "Default", "representation": "more", "text": "{0}" }
                      ]
                    }
                  }
                ],
                "sortBy": [
                  { "itemKey": "TimeGenerated", "sortOrder": 2 }
                ]
              }
            },
            "name": "query-2-1-blocked"
          },
          {
            "type": 1,
            "content": {
              "json": "### 2.2 Categorías más frecuentes"
            },
            "name": "label-2-2"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ApiManagementGatewayLogs\n| where TimeGenerated {TimeRange}\n| where ApiId == \"github-redirection\"\n| where Method == \"POST\"\n| where ResponseCode == 400\n| where ResponseBody has \"Content Safety\"\n| extend HasHate = ResponseBody has_cs \"Hate\"\n| extend HasSelfHarm = ResponseBody has_cs \"SelfHarm\"\n| extend HasSexual = ResponseBody has_cs \"Sexual\"\n| extend HasViolence = ResponseBody has_cs \"Violence\"\n| summarize\n    Hate = countif(HasHate),\n    SelfHarm = countif(HasSelfHarm),\n    Sexual = countif(HasSexual),\n    Violence = countif(HasViolence),\n    Total = count()",
              "size": 1,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "barchart",
              "chartSettings": {
                "seriesLabelSettings": [
                  { "seriesName": "Hate", "label": "Odio", "color": "redDark" },
                  { "seriesName": "SelfHarm", "label": "Autolesión", "color": "orange" },
                  { "seriesName": "Sexual", "label": "Sexual", "color": "magenta" },
                  { "seriesName": "Violence", "label": "Violencia", "color": "red" }
                ]
              }
            },
            "customWidth": "50",
            "name": "query-2-2-categories"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ApiManagementGatewayLogs\n| where TimeGenerated {TimeRange}\n| where ApiId == \"github-redirection\"\n| where Method == \"POST\"\n| where ResponseCode == 400\n| where ResponseBody has \"Content Safety\"\n| summarize Violaciones = count() by bin(TimeGenerated, {TimeRange:grain})\n| order by TimeGenerated asc",
              "size": 0,
              "title": "2.3 Tendencia de violaciones de Content Safety",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "linechart",
              "chartSettings": {
                "seriesLabelSettings": [
                  { "seriesName": "Violaciones", "color": "redBright" }
                ],
                "ySettings": { "min": 0 }
              }
            },
            "customWidth": "50",
            "name": "query-2-3-trend"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "contentsafety"
      },
      "name": "group-content-safety"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "## 🛡️ Seguridad — Prompt Shield (Jailbreak / Injection)\n---\n<div style=\"background: linear-gradient(90deg, #5C2D91 0%, #B4009E 100%); padding: 10px 20px; border-radius: 8px; margin-bottom: 12px;\">\n<span style=\"color: #fff; font-size: 13px;\">Detección de ataques de manipulación: <strong>Jailbreak</strong> · <strong>Prompt Injection</strong></span>\n</div>"
            },
            "name": "section-3-title"
          },
          {
            "type": 1,
            "content": {
              "json": "### 3.1 Intentos de jailbreak detectados (detalle)"
            },
            "name": "label-3-1"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ApiManagementGatewayLogs\n| where TimeGenerated {TimeRange}\n| where ApiId == \"github-redirection\"\n| where ResponseCode == 400\n| where Method == \"POST\"\n| where ResponseBody has \"Prompt Shield\"\n| extend\n    Prompt = extract(@\"\"\"content\"\":\\s*\"\"([^\"\"]+)\"\"\", 1, RequestBody),\n    BlockedBy = \"Prompt Shield\",\n    Category = \"Jailbreak/Injection\",\n    Severity = 10\n| project TimeGenerated, CallerIpAddress, Prompt, BlockedBy, Category, Severity, TotalTime\n| order by TimeGenerated desc",
              "size": 0,
              "showAnalytics": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Severity",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        { "operator": ">=", "thresholdValue": "10", "representation": "redDark", "text": "🔴 {0} — CRÍTICO" },
                        { "operator": "Default", "representation": "yellow", "text": "{0}" }
                      ]
                    }
                  },
                  {
                    "columnMatch": "BlockedBy",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        { "operator": "Default", "representation": "Sev0", "text": "{0}" }
                      ]
                    }
                  },
                  {
                    "columnMatch": "Category",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        { "operator": "Default", "representation": "Sev0", "text": "🚨 {0}" }
                      ]
                    }
                  },
                  {
                    "columnMatch": "TotalTime",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "coldHot"
                    },
                    "numberFormat": {
                      "unit": 23,
                      "options": { "style": "decimal", "maximumFractionDigits": 0 }
                    }
                  }
                ],
                "sortBy": [
                  { "itemKey": "TimeGenerated", "sortOrder": 2 }
                ]
              }
            },
            "name": "query-3-1-jailbreak"
          },
          {
            "type": 1,
            "content": {
              "json": "### 3.2 Top IPs con más intentos de jailbreak"
            },
            "name": "label-3-2"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "ApiManagementGatewayLogs\n| where TimeGenerated {TimeRange}\n| where ApiId == \"github-redirection\"\n| where Method == \"POST\"\n| where ResponseCode == 400\n| where ResponseBody has \"Prompt Shield\"\n| summarize\n    IntentosJailbreak = count(),\n    PrimerIntento = min(TimeGenerated),\n    UltimoIntento = max(TimeGenerated)\n    by CallerIpAddress\n| order by IntentosJailbreak desc\n| take 20",
              "size": 0,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "IntentosJailbreak",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "hotCold",
