              "version": "KqlItem/1.0",
              "query": "ApiManagementGatewayLogs\n| where TimeGenerated {TimeRange}\n| where ApiId == \"github-redirection\"\n| where Method == \"POST\"\n| extend HoraUTC = hourofday(TimeGenerated)\n| summarize Peticiones = count() by HoraUTC\n| order by HoraUTC asc",
