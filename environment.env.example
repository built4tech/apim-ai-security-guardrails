######################################
# TOKENS
######################################
# API key del proveedor de modelo (por defecto Groq: https://console.groq.com -> API Keys).
# APIM la lee desde Key Vault (secreto model-api-token); el cliente directo (opción 1) la usa vía Bearer.
GROQ_API_KEY=

# Subscription key 'master' de Azure API Management (la genera bootstrap.ps1).
AZURE_APIM_KEY=

# Content Safety usa Managed Identity (disableLocalAuth=true en la plantilla Bicep).
# Solo rellena esta key si habilitas la autenticación local para tools/ContentSafetySetup.py.
CONTENT_SAFETY_KEY=

######################################
# ENDPOINTS
######################################
# Conexión directa al proveedor de modelo (Groq) — opción 1 de modelconn.py
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# Conexión via Azure API Management (sin seguridad)
AZURE_APIM_ENDPOINT=https://<apim-name>.azure-api.net/gh-redirect
# Conexión via APIM + Content Safety
AZURE_APIM_ENDPOINT_CS=https://<apim-name>.azure-api.net/gh-cs-redirect
# Conexión via APIM + Prompt Shield
AZURE_APIM_ENDPOINT_PS=https://<apim-name>.azure-api.net/gh-ps-redirect
# Conexión via APIM + Content Safety & Prompt Shield
AZURE_APIM_ENDPOINT_CS_PS=https://<apim-name>.azure-api.net/gh-cs-ps-redirect

# Content Safety
CONTENT_SAFETY_ENDPOINT=https://<content-safety-name>.cognitiveservices.azure.com/
PROMPT_SHIELD_ENDPOINT=https://<content-safety-name>.cognitiveservices.azure.com/contentsafety/text:shieldPrompt?api-version=2024-09-01
